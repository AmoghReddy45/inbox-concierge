# Google OAuth (Google Auth Platform → create OAuth client, web application)
# Authorized redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to <request origin>/api/auth/callback/google
GOOGLE_REDIRECT_URI=

# Session cookie encryption secret (any long random string)
AUTH_SECRET=

# LLM provider — Moonshot AI (platform.kimi.ai). Without a key the app runs
# in an honestly-labeled heuristic mode; with a key it classifies with Kimi.
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
# Reasoning effort for kimi-k3 ("low" recommended for triage; "off" omits the param)
KIMI_REASONING_EFFORT=low

# Token prices in USD per million tokens — used to compute the real cost
# telemetry shown in the UI. Leave unset to display "n/a" (never fabricated).
KIMI_PRICE_IN_USD_PER_MTOK=3
KIMI_PRICE_CACHED_IN_USD_PER_MTOK=0.3
KIMI_PRICE_OUT_USD_PER_MTOK=15
